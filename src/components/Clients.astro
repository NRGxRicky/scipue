---
const clientLogos = [
  "/assets/9e32cfbd85d2244d5ccb1e259e16fbb0.png",
  "/assets/be491c9f342400714fcf91f7c59acc60.png",
  "/assets/d77605d1c3a9989526abdeeb5b600874.png",
  "/assets/1ea2041c021c61ac07455694a640d21f.png",
  "/assets/9e1276634823fbdeb2f1e4ecab60a6dd.png",
  "/assets/e98e5d7e5434cf9cfb4c369bfabf8806.png",
  "/assets/cb0041b7962e77a1dc13ea0c8fc0f686.png",
  "/assets/239d04578edad83c04a08b576cb9beb5.png",
  "/assets/68b9a9ca86731a00b540ae8e68951374.png",
  "/assets/b7454b1d8b2e85e142f45167c2d19fa9.png"
];

// Duplicate logos for smooth infinite scrolling loop
const doubledLogos = [...clientLogos, ...clientLogos];
---

<section id="clientes" class="py-20 bg-slate-900/30 relative overflow-hidden border-y border-white/5">
  
  <div class="max-w-7xl mx-auto px-6 relative z-10 mb-12 text-center">
    <h2 class="text-xs font-semibold text-cyan-400 uppercase tracking-widest mb-3">Nuestra Red</h2>
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-4 font-display">
      Empresas que Confían en SCI
    </h3>
    <p class="text-sm text-slate-400 max-w-xl mx-auto font-sans leading-relaxed">
      Suministramos servicios de ingeniería y construcción a líderes de los ramos automotriz, comercial, alimenticio y manufacturero.
    </p>
  </div>

  <!-- Infinite Scroll Slider Container -->
  <div class="relative w-full overflow-hidden py-4 flex flex-col justify-center items-center">
    
    <!-- Left & Right Shadows to fade logos at borders -->
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-slate-950 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-slate-950 to-transparent z-10 pointer-events-none"></div>

    <!-- Scroller track -->
    <div class="flex gap-12 w-max animate-infinite-scroll hover:[animation-play-state:paused] py-4">
      {doubledLogos.map((logo, idx) => (
        <div class="flex items-center justify-center w-36 h-20 px-4 rounded-xl bg-slate-900/60 border border-white/5 hover:border-cyan-500/20 shadow-sm hover:shadow-cyan-950/20 transition-all duration-300 group">
          <img 
            src={logo} 
            alt="Cliente SCI" 
            class="max-w-full max-h-12 object-contain filter grayscale opacity-55 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-105"
          />
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes infinite-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-50% - 1.5rem)); /* Compensate for half width and spacing */
    }
  }

  .animate-infinite-scroll {
    animation: infinite-scroll 35s linear infinite;
  }
</style>
