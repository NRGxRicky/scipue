---
const services = [
  {
    title: "Montaje Eléctrico de Potencia",
    description: "Instalación de subestaciones, plantas de emergencia y tableros generales de distribución de potencia en media y baja tensión.",
    img: "/assets/d00bdaaa4ff6f2ec903017eb1617ca3f.png",
    icon: "bolt"
  },
  {
    title: "Automatización y Control",
    description: "Programación de PLCs, interfaces HMI, sistemas SCADA y ensamble de tableros de control con componentes de grado industrial.",
    img: "/assets/e9f29324d2bf3c751a3d5d055b101e5f.png",
    icon: "cpu"
  },
  {
    title: "Instalaciones Eléctricas de Fuerza",
    description: "Canalizaciones con tubería rígida y charola portacable, cableado de motores, sistemas de bombeo e iluminación industrial.",
    img: "/assets/4de3297230969f7c9d02878b1134b6aa.png",
    icon: "wrench"
  },
  {
    title: "Instrumentación Industrial",
    description: "Montaje y calibración de instrumentos de medición para flujo, presión, temperatura y nivel con integración a sistemas de control.",
    img: "/assets/030cf524f647fefa4233c93cbac24588.png",
    icon: "activity"
  },
  {
    title: "Mantenimiento Electromecánico",
    description: "Mantenimiento preventivo y correctivo a maquinaria industrial, motores eléctricos, tableros de transferencia y transformadores.",
    img: "/assets/69e0d18be34f06f6f4a01afd2e297b8b.png",
    icon: "cog"
  },
  {
    title: "Sistemas de Tierra y Pararrayos",
    description: "Cálculo, diseño y montaje de sistemas de puesta a tierra y sistemas pararrayos para protección de equipos sensibles y personal.",
    img: "/assets/7dca1c7d2dcac1fc8b884fcda9f1508c.png",
    icon: "shield"
  },
  {
    title: "Neumática e Hidráulica",
    description: "Instalación de redes de aire comprimido, sistemas hidráulicos de potencia, colectores de válvulas y tuberías de proceso.",
    img: "/assets/cfd37c06b45ea8defd664c0bbde13d76.png",
    icon: "droplet"
  },
  {
    title: "Ingeniería e Integración",
    description: "Desarrollo de diagramas unifilares, ingeniería de detalle, proyectos llave en mano e integración tecnológica de procesos.",
    img: "/assets/d18241bffb747a6598056de61f904840.png",
    icon: "folder"
  }
];
---

<section id="servicios" class="py-24 bg-slate-900/30 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-semibold text-brand-blue uppercase tracking-widest mb-3">Servicios Especializados</h2>
      <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4 font-display">
        Soluciones Integrales para la Industria
      </h3>
      <div class="w-12 h-0.5 bg-brand-blue mx-auto mb-6"></div>
      <p class="text-slate-400 font-sans text-sm leading-relaxed">
        Garantizamos la máxima disponibilidad y seguridad de sus instalaciones mediante estándares internacionales y personal altamente capacitado.
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service) => (
        <div class="group relative rounded-xl bg-slate-900/60 border border-white/5 overflow-hidden hover:border-brand-blue/30 transition-all duration-300 hover:shadow-xl hover:shadow-black/40 flex flex-col justify-between">
          
          <!-- Image container -->
          <div class="relative w-full aspect-video overflow-hidden border-b border-white/5">
            <div class="absolute inset-0 bg-slate-950/40 z-10 group-hover:bg-slate-950/15 transition-all duration-500"></div>
            <img 
              src={service.img} 
              alt={service.title} 
              class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700 mix-blend-luminosity group-hover:mix-blend-normal"
            />
          </div>

          <!-- Card Content -->
          <div class="p-6 flex-grow flex flex-col justify-between">
            <div class="text-left">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded bg-slate-950 flex items-center justify-center text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition-colors duration-300">
                  {service.icon === 'bolt' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>}
                  {service.icon === 'cpu' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>}
                  {service.icon === 'wrench' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>}
                  {service.icon === 'activity' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>}
                  {service.icon === 'cog' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>}
                  {service.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622" /></svg>}
                  {service.icon === 'droplet' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>}
                  {service.icon === 'folder' && <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>}
                </div>
                <h4 class="text-sm font-bold text-white group-hover:text-brand-blue transition-colors duration-300 font-display">
                  {service.title}
                </h4>
              </div>
              <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
                {service.description}
              </p>
            </div>
            
            <!-- Symmetrical discrete bottom visual accent -->
            <div class="w-full h-[1px] bg-white/5 group-hover:bg-brand-blue/30 transition-all duration-300 mt-6"></div>
          </div>
          
        </div>
      ))}
    </div>

  </div>
</section>
