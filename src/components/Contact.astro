---
---

<section id="contacto" class="py-24 bg-slate-900/10 relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
      
      <!-- Contact Info Section -->
      <div class="lg:col-span-5 flex flex-col justify-between h-full text-left">
        <div>
          <h2 class="text-xs font-semibold text-brand-blue uppercase tracking-widest mb-3">Contacto Directo</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-6 font-display leading-tight">
            ¿Tiene un Proyecto en Mente? <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-blue-400">Cotice con Nosotros</span>
          </h3>
          <div class="w-12 h-0.5 bg-brand-blue mb-8"></div>
          
          <p class="text-sm text-slate-400 mb-10 leading-relaxed font-sans">
            ¡CONTÁCTANOS AHORA Y VUELVE REALIDAD ESE PROYECTO SOÑADO! Nuestro equipo técnico está disponible para responder sus solicitudes de información y cotizaciones.
          </p>

          <!-- Contact items list -->
          <div class="space-y-4">
            
            <!-- WhatsApp Item -->
            <a 
              href="https://wa.me/5212282206491" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/60 border border-white/5 hover:border-brand-blue/30 transition-all duration-300 group"
            >
              <div class="w-10 h-10 rounded bg-slate-950 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors duration-300 shadow-sm shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.035-4.22c1.661.989 3.275 1.562 4.957 1.563 5.514 0 10.002-4.494 10.005-10.011.002-2.673-1.03-5.184-2.906-7.06C16.271 2.395 13.766 1.36 11.1 1.36 5.589 1.36 1.1 5.85 1.096 11.368c-.001 1.76.474 3.42 1.378 4.908l-.995 3.637 3.737-.981-.129-.153z"/>
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-slate-400">WhatsApp Comercial</span>
                <span class="text-sm font-bold text-white group-hover:text-brand-blue transition-colors">+52 228 220 6491</span>
              </div>
            </a>

            <!-- Email Item -->
            <a 
              href="mailto:proyectos@scipue.com" 
              class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/60 border border-white/5 hover:border-brand-blue/30 transition-all duration-300 group"
            >
              <div class="w-10 h-10 rounded bg-slate-950 flex items-center justify-center text-brand-blue group-hover:bg-brand-blue group-hover:text-white transition-colors duration-300 shadow-sm shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-slate-400">Ingeniería y Presupuestos</span>
                <span class="text-sm font-bold text-white group-hover:text-brand-blue transition-colors">proyectos@scipue.com</span>
              </div>
            </a>

            <!-- Location Item -->
            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-900/30 border border-white/5 shadow-sm">
              <div class="w-10 h-10 rounded bg-slate-950 flex items-center justify-center text-slate-400 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] text-slate-400">Cobertura Técnica</span>
                <span class="text-sm font-bold text-white">Puebla y Centro del País</span>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Contact Form Section -->
      <div class="lg:col-span-7">
        <div class="glass border border-white/5 rounded-2xl p-8 shadow-xl relative">
          
          <h4 class="text-base font-bold text-white mb-6 font-display text-left">Solicitud de Cotización Técnica</h4>

          <!-- Success Message Container -->
          <div id="success-alert" class="hidden mb-6 p-4 rounded-lg bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-left text-sm font-sans flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <p class="font-semibold mb-1">¡Formulario enviado!</p>
              <p class="text-xs text-emerald-400/90">Su solicitud ha sido registrada correctamente. Un ingeniero de soporte técnico se comunicará con usted a la brevedad.</p>
            </div>
          </div>

          <form id="contact-form" class="space-y-6 text-left">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              
              <!-- Name Input -->
              <div class="flex flex-col">
                <label for="name" class="text-[10px] font-semibold text-slate-400 mb-2 uppercase tracking-wider">Nombre Completo</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Ej. Ing. Carlos Mendoza" 
                  class="px-4 py-3 rounded-lg bg-slate-950 border border-slate-800/80 text-slate-100 placeholder-slate-700 focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none text-xs font-sans transition-all duration-300"
                />
              </div>

              <!-- Phone Input -->
              <div class="flex flex-col">
                <label for="phone" class="text-[10px] font-semibold text-slate-400 mb-2 uppercase tracking-wider">Teléfono / Celular</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="Ej. 222 123 4567" 
                  class="px-4 py-3 rounded-lg bg-slate-950 border border-slate-800/80 text-slate-100 placeholder-slate-700 focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none text-xs font-sans transition-all duration-300"
                />
              </div>

            </div>

            <!-- Email Input -->
            <div class="flex flex-col">
              <label for="email" class="text-[10px] font-semibold text-slate-400 mb-2 uppercase tracking-wider">Correo Corporativo</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="Ej. carlos.mendoza@empresa.com" 
                class="px-4 py-3 rounded-lg bg-slate-950 border border-slate-800/80 text-slate-100 placeholder-slate-700 focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none text-xs font-sans transition-all duration-300"
              />
            </div>

            <!-- Message Textarea -->
            <div class="flex flex-col">
              <label for="message" class="text-[10px] font-semibold text-slate-400 mb-2 uppercase tracking-wider">Detalles de la Solicitud o Proyecto</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Describa brevemente los alcances de su proyecto o los requerimientos técnicos del servicio..." 
                class="px-4 py-3 rounded-lg bg-slate-950 border border-slate-800/80 text-slate-100 placeholder-slate-700 focus:border-brand-blue focus:ring-1 focus:ring-brand-blue outline-none text-xs font-sans resize-none transition-all duration-300"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full py-3.5 px-6 text-xs font-bold rounded-lg bg-brand-blue text-white hover:bg-brand-blue-hover active:scale-[0.99] transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Enviar Requerimientos</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>

          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const alert = document.getElementById('success-alert');

  if (form && alert) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      console.log('Sending form data...', {
        name: (document.getElementById('name') as HTMLInputElement).value,
        phone: (document.getElementById('phone') as HTMLInputElement).value,
        email: (document.getElementById('email') as HTMLInputElement).value,
        message: (document.getElementById('message') as HTMLTextAreaElement).value,
      });

      alert.classList.remove('hidden');
      form.reset();

      alert.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      
      setTimeout(() => {
        alert.classList.add('hidden');
      }, 8000);
    });
  }
</script>
