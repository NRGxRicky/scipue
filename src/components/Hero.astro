---
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-32 pb-24 overflow-hidden bg-slate-950">
  
  <!-- Subtle tech-grid pattern -->
  <div class="absolute inset-0 tech-grid opacity-25 z-0"></div>
  
  <!-- Symmetrical corporate light wash -->
  <div class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-brand-blue/5 rounded-full blur-[160px] pointer-events-none z-0"></div>
  <div class="absolute bottom-0 left-0 w-[40rem] h-[40rem] bg-slate-900/40 rounded-full blur-[160px] pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full flex flex-col gap-16">
    
    <!-- Hero Main content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left side: Text -->
      <div class="lg:col-span-7 flex flex-col items-start text-left reveal">
        
        <!-- Corporate Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-slate-900 border border-white/5 text-xs font-semibold text-brand-blue mb-6 uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue"></span>
          Ingeniería e Integración Industrial
        </div>

        <!-- Serious Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-6 font-display leading-tight">
          Servicios y Comercialización <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-blue-400">Industrial AyG</span>
        </h1>

        <!-- Copy -->
        <p class="text-base text-slate-300 mb-8 max-w-xl font-sans leading-relaxed">
          Hoy <strong class="text-white font-semibold">SCI</strong>, antes <strong class="text-slate-200 font-semibold">SEIR Automatización de Puebla</strong>, es una empresa especializada en proporcionar soluciones de ingeniería de primer nivel en montajes eléctricos, automatización y obra civil para la manufactura mexicana.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a 
            href="#servicios" 
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-lg bg-brand-blue text-white hover:bg-brand-blue-hover active:scale-98 transition-all gap-2 shadow-md shadow-brand-blue/10 cursor-pointer"
          >
            Nuestros Servicios
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a 
            href="#contacto" 
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-lg bg-slate-900 text-slate-200 border border-white/10 hover:bg-slate-800 hover:text-white active:scale-98 transition-all cursor-pointer"
          >
            Contacto Técnico
          </a>
        </div>
        
      </div>

      <!-- Right side: Visual -->
      <div class="lg:col-span-5 relative flex items-center justify-center reveal" style="transition-delay: 200ms;">
        <div class="relative w-full aspect-square max-w-[420px] lg:max-w-none">
          
          <!-- Outer border wrapper -->
          <div class="absolute inset-0 rounded-xl bg-slate-900 border border-white/10 p-2 shadow-2xl">
            <div class="w-full h-full bg-slate-950 rounded-lg overflow-hidden relative border border-white/5">
              <!-- Client Hero Image -->
              <img 
                src="/assets/3f642e9f5fcea5cef6923ca195b1c15c.png" 
                alt="SCI Ingeniería Industrial"
                class="w-full h-full object-cover opacity-90 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700"
              />
            </div>
          </div>

          <!-- Discrete Logo badge -->
          <div class="absolute top-4 right-4 glass rounded-lg px-3 py-2 border border-white/10 shadow-lg">
            <img src="/assets/188a9130f706f7fcaeb8626e3128eaaa.png" alt="SCI Logo" class="h-6 object-contain" />
          </div>

        </div>
      </div>

    </div>

    <!-- Corporate Stats Section (Replaces Static Badges) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-t border-white/5 pt-12 reveal" style="transition-delay: 300ms;" id="stats-container">
      
      <!-- Stat 1 -->
      <div class="flex gap-4 items-center text-left p-6 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-12 h-12 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-3xl font-extrabold text-white font-display tracking-tight flex items-baseline">
            +<span class="counter" data-target="30">0</span>
          </span>
          <span class="text-xs text-slate-400 font-sans mt-0.5 font-medium">Años de Trayectoria (Est. 1992)</span>
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="flex gap-4 items-center text-left p-6 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-12 h-12 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-3xl font-extrabold text-white font-display tracking-tight flex items-baseline">
            +<span class="counter" data-target="500">0</span>
          </span>
          <span class="text-xs text-slate-400 font-sans mt-0.5 font-medium">Proyectos Electromecánicos y Civiles</span>
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="flex gap-4 items-center text-left p-6 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-12 h-12 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-3xl font-extrabold text-white font-display tracking-tight flex items-baseline">
            <span class="counter" data-target="100">0</span>%
          </span>
          <span class="text-xs text-slate-400 font-sans mt-0.5 font-medium">Clientes Industriales Satisfechos</span>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Count-up stats logic
  const statsContainer = document.getElementById('stats-container');
  const counters = document.querySelectorAll('.counter');
  
  let started = false;

  function startCountUp() {
    counters.forEach((counter) => {
      const target = parseInt(counter.getAttribute('data-target') || '0', 10);
      const duration = 2000; // Animation duration in ms
      const startTime = performance.now();
      
      function updateNumber(currentTime: number) {
        const elapsedTime = currentTime - startTime;
        const progress = Math.min(elapsedTime / duration, 1);
        
        // Easing function (easeOutQuad)
        const easeProgress = progress * (2 - progress);
        
        const currentValue = Math.floor(easeProgress * target);
        counter.textContent = currentValue.toString();
        
        if (progress < 1) {
          requestAnimationFrame(updateNumber);
        } else {
          counter.textContent = target.toString(); // Ensure exact target is printed
        }
      }
      
      requestAnimationFrame(updateNumber);
    });
  }

  if (statsContainer) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !started) {
          started = true;
          startCountUp();
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2
    });

    observer.observe(statsContainer);
  }
</script>
