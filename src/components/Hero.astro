---
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center pt-32 pb-24 overflow-hidden bg-slate-950">
  
  <!-- Subtle tech-grid pattern -->
  <div class="absolute inset-0 tech-grid opacity-25 z-0"></div>
  
  <!-- Symmetrical corporate light wash -->
  <div class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-brand-blue/5 rounded-full blur-[160px] pointer-events-none z-0"></div>
  <div class="absolute bottom-0 left-0 w-[40rem] h-[40rem] bg-slate-900/40 rounded-full blur-[160px] pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10 w-full flex flex-col gap-16">
    
    <!-- Hero Main content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left side: Text -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Corporate Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-slate-900 border border-white/5 text-xs font-semibold text-brand-blue mb-6 uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue"></span>
          Ingeniería e Integración Industrial
        </div>

        <!-- Serious Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white mb-6 font-display leading-tight">
          Servicios y Comercialización <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue to-blue-400">Industrial AyG</span>
        </h1>

        <!-- Copy -->
        <p class="text-base text-slate-300 mb-8 max-w-xl font-sans leading-relaxed">
          Hoy <strong class="text-white font-semibold">SCI</strong>, antes <strong class="text-slate-200 font-semibold">SEIR Automatización de Puebla</strong>, es una empresa especializada en proporcionar soluciones de ingeniería de primer nivel en montajes eléctricos, automatización y obra civil para la manufactura mexicana.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          <a 
            href="#servicios" 
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-lg bg-brand-blue text-white hover:bg-brand-blue-hover active:scale-98 transition-all gap-2 shadow-md shadow-brand-blue/10 cursor-pointer"
          >
            Nuestros Servicios
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a 
            href="#contacto" 
            class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-lg bg-slate-900 text-slate-200 border border-white/10 hover:bg-slate-800 hover:text-white active:scale-98 transition-all cursor-pointer"
          >
            Contacto Técnico
          </a>
        </div>
        
      </div>

      <!-- Right side: Visual -->
      <div class="lg:col-span-5 relative flex items-center justify-center">
        <div class="relative w-full aspect-square max-w-[420px] lg:max-w-none">
          
          <!-- Outer border wrapper -->
          <div class="absolute inset-0 rounded-xl bg-slate-900 border border-white/10 p-2 shadow-2xl">
            <div class="w-full h-full bg-slate-950 rounded-lg overflow-hidden relative border border-white/5">
              <!-- Client Hero Image -->
              <img 
                src="/assets/3f642e9f5fcea5cef6923ca195b1c15c.png" 
                alt="SCI Ingeniería Industrial"
                class="w-full h-full object-cover opacity-90 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700"
              />
            </div>
          </div>

          <!-- Discrete Logo badge -->
          <div class="absolute top-4 right-4 glass rounded-lg px-3 py-2 border border-white/10 shadow-lg">
            <img src="/assets/188a9130f706f7fcaeb8626e3128eaaa.png" alt="SCI Logo" class="h-6 object-contain" />
          </div>

        </div>
      </div>

    </div>

    <!-- Corporate Value Badges (Replaces bouncy animated widget) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-t border-white/5 pt-12">
      <div class="flex gap-4 items-start text-left p-4 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-10 h-10 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0 mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white font-display mb-1">Ingeniería Eléctrica y Civil</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Montajes de subestaciones y tendido de líneas de potencia bajo normas de la CFE y NMX.</p>
        </div>
      </div>

      <div class="flex gap-4 items-start text-left p-4 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-10 h-10 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0 mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white font-display mb-1">Automatización Industrial</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Integración de PLCs, pantallas HMI y programación a medida para control de maquinaria.</p>
        </div>
      </div>

      <div class="flex gap-4 items-start text-left p-4 rounded-lg bg-slate-900/40 border border-white/5">
        <div class="w-10 h-10 rounded bg-blue-950 flex items-center justify-center text-brand-blue shrink-0 mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622" />
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold text-white font-display mb-1">Garantía de Cumplimiento</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Apego irrestricto a los reglamentos de seguridad laboral NOM, ISO y seguridad industrial.</p>
        </div>
      </div>
    </div>

  </div>
</section>
