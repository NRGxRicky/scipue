<footer class="bg-slate-950 py-16 border-t border-white/5 relative z-10 text-left">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-12">
    
    <!-- Info Column -->
    <div class="md:col-span-6 flex flex-col items-start gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-900 border border-slate-700/50">
          <span class="text-lg font-bold font-display text-brand-blue">S</span>
        </div>
        <span class="text-lg font-bold font-display text-white tracking-wide">SCI</span>
      </div>
      <p class="text-xs text-slate-400 max-w-sm font-sans leading-relaxed">
        Servicios y Comercialización Industrial AyG es la evolución de SEIR Automatización de Puebla (Est. 1992). Brindamos soluciones de alto nivel técnico para la automatización e infraestructura industrial en México.
      </p>
    </div>

    <!-- Quick Links Column -->
    <div class="md:col-span-3 flex flex-col items-start gap-4">
      <h4 class="text-xs font-bold text-white uppercase tracking-wider">Enlaces Rápidos</h4>
      <nav class="flex flex-col gap-2.5">
        <a href="#inicio" class="text-xs text-slate-400 hover:text-brand-blue transition-colors">Inicio</a>
        <a href="#servicios" class="text-xs text-slate-400 hover:text-brand-blue transition-colors">Servicios Industriales</a>
        <a href="#construccion" class="text-xs text-slate-400 hover:text-brand-blue transition-colors">Construcción y Naves</a>
        <a href="#clientes" class="text-xs text-slate-400 hover:text-brand-blue transition-colors">Nuestros Clientes</a>
        <a href="#contacto" class="text-xs text-slate-400 hover:text-brand-blue transition-colors">Contacto de Ingeniería</a>
      </nav>
    </div>

    <!-- Legal/Contact Column -->
    <div class="md:col-span-3 flex flex-col items-start gap-4">
      <h4 class="text-xs font-bold text-white uppercase tracking-wider">Contacto Oficial</h4>
      <div class="flex flex-col gap-2.5 text-xs text-slate-400 font-sans">
        <span>proyectos@scipue.com</span>
        <span>Tel: +52 228 220 6491</span>
        <span>Puebla, México</span>
      </div>
    </div>

  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 font-sans">
    <span>&copy; {new Date().getFullYear()} SCI Servicios y Comercialización Industrial AyG. Todos los derechos reservados.</span>
    <div class="flex gap-6">
      <a href="#inicio" class="hover:text-slate-300 transition-colors">Aviso de Privacidad</a>
      <a href="#inicio" class="hover:text-slate-300 transition-colors">Términos de Servicio</a>
    </div>
  </div>
</footer>
