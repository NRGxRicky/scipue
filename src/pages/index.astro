---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Construction from '../components/Construction.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="SCI Servicios y Comercialización Industrial AyG"
  description="SCI Servicios y Comercialización Industrial AyG (antes SEIR Automatización de Puebla) es una empresa de ingeniería especializada en montajes eléctricos de potencia, automatización, instrumentación y servicios de construcción de naves industriales."
>
  <div class="bg-slate-950 min-h-screen text-slate-100 flex flex-col selection:bg-cyan-500 selection:text-slate-950">
    <!-- Header/Nav -->
    <Header />

    <!-- Main Content -->
    <main class="flex-grow">
      <Hero />
      <Services />
      <Construction />
      <Clients />
      <Contact />
    </main>

    <!-- Footer -->
    <Footer />
  </div>
</Layout>
